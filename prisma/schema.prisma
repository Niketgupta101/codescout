generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // app uses the pooled connection at runtime - handles short-lived queries efficiently behind PgBouncer
  url       = env("DATABASE_URL")
  // migrations need a direct connection because PgBouncer's transaction-mode pooling breaks long-running DDL
  // for non-Neon setups, leave DIRECT_URL unset and Prisma falls back to DATABASE_URL
  directUrl = env("DIRECT_URL")
}

model User {
  id        String        @id @default(uuid())
  name      String        @default("") // computed
  firstName String        @default("")
  lastName  String        @default("")
  email     String        @unique
  enabled   Boolean
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  deleted   Boolean       @default(false)
  deletedAt DateTime?     @db.Timestamptz(3)
  password  UserPassword?
  sessions  UserSession[]
}

model UserPassword {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique
  passwordHash    String
  attempts        Int      @default(0)
  lastAttemptedAt DateTime @default(now()) @db.Timestamptz(3)
  lastChangedAt   DateTime @default(now()) @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

model UserSession {
  id                    String   @id
  user                  User     @relation(fields: [userId], references: [id])
  userId                String
  refreshTokenHash      String
  refreshTokenExpiresAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
}

model Project {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @unique
  description                String?
  summary                    String?                     @db.Text
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  repositories               Repository[]
  repositoryDirectories      RepositoryDirectory[]
  repositoryFiles            RepositoryFile[]
  repositoryFileSymbols      RepositoryFileSymbol[]
  projectDocuments           ProjectDocument[]
  conversations              Conversation[]
  projectFolders             ProjectFolder[]
  projectTopics              ProjectTopic[]
  projectDocumentTopics      ProjectDocumentTopic[]
  projectDocumentStatements  ProjectDocumentStatement[]
  projectDocumentActionItems ProjectDocumentActionItem[]
  projectActionItems         ProjectActionItem[]
  projectDocumentReferences  ProjectDocumentReference[]
  projectDocumentCorrections ProjectDocumentCorrection[]
  projectFolderImports       ProjectFolderImport[]
  decisionRecords            DecisionRecord[]
}

model RepositoryDirectory {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId String?               @db.Uuid
  parent   RepositoryDirectory?  @relation("RepositoryDirectoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children RepositoryDirectory[] @relation("RepositoryDirectoryHierarchy")

  repositoryFiles RepositoryFile[]

  relatedProjectTopics ProjectTopic[] @relation("ProjectTopicRelatedDirectories")

  fullPath String
  depth    Int
  summary  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, fullPath])
  @@index([projectId, parentId])
  @@index([projectId, depth])
}

enum RepositoryFileLanguage {
  typescript
  javascript
  csv
  markdown
  pdf
  json
  yaml
  plaintext
  prisma
}

model RepositoryFile {
  id                           String                        @id @default(uuid()) @db.Uuid
  projectId                    String                        @db.Uuid
  project                      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId                 String                        @db.Uuid
  repository                   Repository                    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  directoryId                  String?                       @db.Uuid
  directory                    RepositoryDirectory?          @relation(fields: [directoryId], references: [id], onDelete: SetNull)
  fullPath                     String
  language                     RepositoryFileLanguage
  rawContent                   String                        @db.Text
  summary                      String?                       @db.Text
  summaryEmbedding             Unsupported("halfvec(3072)")?
  metadata                     Json?
  checksum                     String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  symbols                      RepositoryFileSymbol[]
  resolvedCanonicalActionItems ProjectActionItem[]           @relation("ProjectActionItemResolvedByFile")

  @@unique([projectId, fullPath])
  @@index([projectId, language])
  @@index([repositoryId])
  @@index([directoryId])
  @@index([checksum])
}

enum SymbolType {
  heading
  term
  function
  class
  variable
  interface
  type
  enum
  module
}

model RepositoryFileSymbol {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @db.Uuid
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryFileId String         @db.Uuid
  repositoryFile   RepositoryFile @relation(fields: [repositoryFileId], references: [id], onDelete: Cascade)
  name             String
  type             SymbolType
  // 1-indexed inclusive line range of the symbol within the source file
  startLine        Int?
  endLine          Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([projectId, type])
  @@index([projectId, name])
  @@index([name])
  @@index([repositoryFileId])
}

enum RepositoryType {
  backendCodebase
  webCodebase
  appCodebase
  custom
}

enum RepositoryStatus {
  pending
  cloning
  indexing
  completed
  failed
}

model Repository {
  id              String           @id @default(uuid()) @db.Uuid
  projectId       String           @db.Uuid
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  url             String
  branch          String           @default("main")
  lastCommitHash  String?
  status          RepositoryStatus @default(pending)
  type            RepositoryType   @default(custom)
  error           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  repositoryFiles RepositoryFile[]
}

enum DocumentStatus {
  pending
  indexing
  completed
  failed
}

enum ProjectDocumentProvider {
  googleDrive
  chat
  manual
}

enum ProjectDocumentType {
  conceptPaper
  scopeDocument
  transcript
  userStory
  implementationPlan
  feedback
  changeRequest
  chat
  architectureDecisionRecord
  knowledgeDoc
  other
}

model ProjectDocument {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @db.Uuid
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectFolderId String?        @db.Uuid
  projectFolder   ProjectFolder? @relation(fields: [projectFolderId], references: [id], onDelete: SetNull)

  name                       String
  provider                   ProjectDocumentProvider
  providerExternalIds        String[]
  providerExternalModifiedAt DateTime?
  // inferred genre; other = generic-lens catch-all so a novel genre routes instead of mis-filing
  type                       ProjectDocumentType           @default(other)
  // raw classifier output (type rationale, confidence, maturity cues); audit/correction only, not queried
  aiClassificationOutput     String?                       @db.Text
  artifactKey                String?
  versionLabel               String?
  path                       String
  // original format provenance (docx/pdf/xlsx/...); open-ended since markitdown normalizes to markdown upstream
  contentType                String
  contentRaw                 String                        @db.Text
  status                     DocumentStatus                @default(pending)
  error                      String?                       @db.Text
  summary                    String?                       @db.Text
  summaryEmbedding           Unsupported("halfvec(3072)")?
  checksum                   String?
  // event time (meeting/doc date), parsed from filename or body - distinct from createdAt (ingest time)
  occurredAt                 DateTime
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  supersedesDocumentId  String?           @db.Uuid
  supersedesDocument    ProjectDocument?  @relation("ProjectDocumentVersionLineage", fields: [supersedesDocumentId], references: [id], onDelete: SetNull)
  supersededByDocuments ProjectDocument[] @relation("ProjectDocumentVersionLineage")

  topics                       ProjectDocumentTopic[]
  statements                   ProjectDocumentStatement[]
  actionItems                  ProjectDocumentActionItem[] @relation("ActionItemDocument")
  resolvedActionItems          ProjectDocumentActionItem[] @relation("ActionItemResolvedBy")
  resolvedCanonicalActionItems ProjectActionItem[]         @relation("ProjectActionItemResolvedByDocument")
  referencesFrom               ProjectDocumentReference[]  @relation("ReferenceFromDocument")
  referencesResolvedTo         ProjectDocumentReference[]  @relation("ReferenceResolvedToDocument")
  corrections                  ProjectDocumentCorrection[]
  relatedProjectTopics         ProjectTopic[]              @relation("ProjectTopicRelatedDocuments")

  @@index([projectId, type])
  @@index([projectId, occurredAt])
  @@index([projectFolderId])
  @@index([providerExternalIds], type: Gin)
  @@index([artifactKey])
  @@index([projectId, checksum])
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  model     String    @default("gpt-4o-mini")
  provider  String    @default("openai")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([projectId, createdAt])
}

model Message {
  id               String                        @id @default(uuid()) @db.Uuid
  conversationId   String                        @db.Uuid
  conversation     Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assitant         Boolean                       @default(false)
  content          String                        @db.Text
  contentEmbedding Unsupported("halfvec(3072)")?
  toolCalls        Json?
  metadata         Json?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
}

enum ProjectFolderProvider {
  googleDrive
}

// an external folder linked to a project for auto-indexing; auth is a global Google service account in env
// (share the folder with the service-account email, paste the link) - no per-row credentials
model ProjectFolder {
  id           String                @id @default(uuid()) @db.Uuid
  projectId    String                @db.Uuid
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  provider     ProjectFolderProvider @default(googleDrive)
  providerId   String
  lastSyncedAt DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  documents    ProjectDocument[]
  imports      ProjectFolderImport[]

  @@unique([projectId, provider, providerId])
}

enum ProjectFolderImportStatus {
  running
  completed
  failed
}

// one import run over a folder; polled by the caller because an import outlives its request
model ProjectFolderImport {
  id              String                    @id @default(uuid()) @db.Uuid
  projectId       String                    @db.Uuid
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectFolderId String                    @db.Uuid
  projectFolder   ProjectFolder             @relation(fields: [projectFolderId], references: [id], onDelete: Cascade)
  status          ProjectFolderImportStatus @default(running)

  filesTotal       Int     @default(0)
  filesProcessed   Int     @default(0)
  documentsChanged Int     @default(0)
  currentPath      String?

  issues     Json      @default("[]")
  error      String?   @db.Text
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  // doubles as the run's heartbeat: a running row that stopped advancing lost the process that owned it
  updatedAt  DateTime  @updatedAt

  @@index([projectFolderId, createdAt])
  @@index([status])
}

enum ProjectTopicType {
  feature
  component
  system
  decision
}

// canonical cross-document topic; per-document occurrences canonicalize into this
model ProjectTopic {
  id               String                        @id @default(uuid()) @db.Uuid
  projectId        String                        @db.Uuid
  project          Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  nameAliases      String[]
  type             ProjectTopicType?
  summary          String?                       @db.Text
  summaryEmbedding Unsupported("halfvec(3072)")?
  // human = a person renamed/retyped it, so canonicalization must not overwrite; suppressed hides it from queries
  origin           ProjectDataOrigin             @default(ai)
  suppressed       Boolean                       @default(false)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  documentTopics               ProjectDocumentTopic[]
  relatedRepositoryDirectories RepositoryDirectory[]  @relation("ProjectTopicRelatedDirectories")
  relatedDocuments             ProjectDocument[]      @relation("ProjectTopicRelatedDocuments")

  @@index([projectId])
}

// per-document occurrence of a topic; canonical link is optional (set by the reconciler)
model ProjectDocumentTopic {
  id                String            @id @default(uuid()) @db.Uuid
  projectId         String            @db.Uuid
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectDocumentId String            @db.Uuid
  projectDocument   ProjectDocument   @relation(fields: [projectDocumentId], references: [id], onDelete: Cascade)
  projectTopicId    String?           @db.Uuid
  projectTopic      ProjectTopic?     @relation(fields: [projectTopicId], references: [id], onDelete: SetNull)
  name              String
  origin            ProjectDataOrigin @default(ai)
  suppressed        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  statements       ProjectDocumentStatement[]  @relation("StatementTopic")
  optionStatements ProjectDocumentStatement[]  @relation("StatementOptionTopic")
  actionItems      ProjectDocumentActionItem[]
  references       ProjectDocumentReference[]

  @@index([projectDocumentId])
  @@index([projectTopicId])
}

enum ProjectDocumentStatementType {
  fact
  proposal
  decision
  question
}

enum ProjectDocumentDecisionStatus {
  open
  accepted
  rejected
  deferred
  superseded
}

enum ProjectDocumentImplementationStatus {
  notStarted
  inProgress
  blocked
  done
  reverted
}

// a thing stated in one document; first-class so it can be vector-searched and filtered by the axes/validity
model ProjectDocumentStatement {
  id                     String               @id @default(uuid()) @db.Uuid
  projectId              String               @db.Uuid
  project                Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectDocumentId      String               @db.Uuid
  projectDocument        ProjectDocument      @relation(fields: [projectDocumentId], references: [id], onDelete: Cascade)
  projectDocumentTopicId String               @db.Uuid
  projectDocumentTopic   ProjectDocumentTopic @relation("StatementTopic", fields: [projectDocumentTopicId], references: [id], onDelete: Cascade)

  // verbatim span from the document (evidence)
  textRaw              String                        @db.Text
  // normalized self-contained claim (what gets embedded / searched / threaded)
  textDerived          String                        @db.Text
  textDerivedEmbedding Unsupported("halfvec(3072)")?

  // orthogonal axes (replace a single growing kind enum)
  type                 ProjectDocumentStatementType
  // superseded is RELATIONAL (reconciler-only)
  decisionStatus       ProjectDocumentDecisionStatus?
  // reverted is RELATIONAL (reconciler-only)
  implementationStatus ProjectDocumentImplementationStatus?

  // the specific option this statement concerns (e.g. "Redis token bucket"); null if about the topic itself
  optionTopicId String?               @db.Uuid
  optionTopic   ProjectDocumentTopic? @relation("StatementOptionTopic", fields: [optionTopicId], references: [id], onDelete: SetNull)
  // why tied to decisionStatus (rejected/deferred/blocked); null when the source states no reason
  reason        String?               @db.Text

  // LOCAL text hint of the prior decision this changes; the reconciler resolves it to an id
  replacesPriorStatementText String?                    @db.Text
  replacesPriorStatementId   String?                    @db.Uuid
  replacesPriorStatement     ProjectDocumentStatement?  @relation("StatementSupersedes", fields: [replacesPriorStatementId], references: [id], onDelete: SetNull)
  supersedingStatements      ProjectDocumentStatement[] @relation("StatementSupersedes")
  replacedByStatementId      String?                    @db.Uuid
  replacedByStatement        ProjectDocumentStatement?  @relation("StatementReplacedBy", fields: [replacedByStatementId], references: [id], onDelete: SetNull)
  replacesStatements         ProjectDocumentStatement[] @relation("StatementReplacedBy")

  actor            String?
  // raw model output for this statement; debugging only, not queried
  aiAnalysisOutput String? @db.Text

  // human = a person edited/authored this statement (pinned); suppressed hides a human-invalidated extraction
  origin     ProjectDataOrigin @default(ai)
  suppressed Boolean           @default(false)

  // event time, from the document
  occurredAt DateTime
  // RELATIONAL bi-temporal validity (reconciler-set); null validUntil = currently valid
  validFrom  DateTime?
  validUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resolvedReferences ProjectDocumentReference[] @relation("ReferenceResolvedToStatement")

  @@index([projectDocumentId])
  @@index([projectDocumentTopicId])
  @@index([projectId, type])
  @@index([projectId, decisionStatus])
  @@index([validUntil])
}

enum ProjectDocumentActionItemStatus {
  open
  inProgress
  blocked
  done
  lapsed
}

// origin of an ai-derived row; human = a person authored or corrected it, so automated re-runs must not overwrite it
enum ProjectDataOrigin {
  ai
  human
}

// where a canonical action item's current status came from; manual is human-set and pinned
enum ProjectActionItemStatusSource {
  extracted
  document
  code
  manual
}

// canonical, deduped action item that per-document occurrences fold into; the durable row a human acts on
model ProjectActionItem {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // normalized compact label + fuller description, synthesized during canonicalization
  title       String
  description String  @db.Text
  owner       String?
  expectedBy  String?

  status       ProjectDocumentActionItemStatus @default(open)
  statusSource ProjectActionItemStatusSource   @default(extracted)
  reason       String?                         @db.Text

  // resolution provenance (reconciler- or human-set)
  resolvedByDocumentId       String?          @db.Uuid
  resolvedByDocument         ProjectDocument? @relation("ProjectActionItemResolvedByDocument", fields: [resolvedByDocumentId], references: [id], onDelete: SetNull)
  resolvedByRepositoryFileId String?          @db.Uuid
  resolvedByRepositoryFile   RepositoryFile?  @relation("ProjectActionItemResolvedByFile", fields: [resolvedByRepositoryFileId], references: [id], onDelete: SetNull)
  // finer-grained code evidence + human stamp are plain provenance pointers (users are soft-deleted, never hard-deleted)
  resolvedBySymbolId         String?          @db.Uuid
  resolvedByUserId           String?
  resolvedAt                 DateTime?

  // human = pinned against automated status recompute
  origin ProjectDataOrigin @default(ai)
  // true when a re-fold left it with no current members (its source spans vanished); surfaced for review, not deleted
  stale  Boolean           @default(false)

  summaryEmbedding Unsupported("halfvec(3072)")?

  // fingerprint of the evidence set and judgment version this item was last judged against; an unchanged
  // digest means the llm judgment is skipped and the prior verdict stands
  resolutionEvidenceDigest     String?
  resolutionAttemptedAt        DateTime?
  // stable anchor: RepositoryFile rows are recreated with new ids on re-index, fullPath is not
  resolvedByRepositoryFilePath String?
  // audit blob for a human to check a verdict against: cited candidate, verbatim quote, confidence, version
  resolutionEvidence           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentActionItems ProjectDocumentActionItem[]

  @@index([projectId, status])
}

// who owes what by when; status=lapsed is RELATIONAL (silence != lapsed)
model ProjectDocumentActionItem {
  id                     String                @id @default(uuid()) @db.Uuid
  projectId              String                @db.Uuid
  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectDocumentId      String                @db.Uuid
  projectDocument        ProjectDocument       @relation("ActionItemDocument", fields: [projectDocumentId], references: [id], onDelete: Cascade)
  projectDocumentTopicId String?               @db.Uuid
  projectDocumentTopic   ProjectDocumentTopic? @relation(fields: [projectDocumentTopicId], references: [id], onDelete: SetNull)
  // canonical item this occurrence folds into (reconciler-set)
  projectActionItemId    String?               @db.Uuid
  projectActionItem      ProjectActionItem?    @relation(fields: [projectActionItemId], references: [id], onDelete: SetNull)
  // origin=human survives re-extraction; suppressed hides a human-invalidated occurrence
  origin                 ProjectDataOrigin     @default(ai)
  suppressed             Boolean               @default(false)

  // null when the source tracks the work without naming who is accountable, as a task list or tracker row does
  owner                String?
  description          String                          @db.Text
  // "next meeting" / "before launch" / a date - free text
  expectedBy           String?
  status               ProjectDocumentActionItemStatus @default(open)
  // what the item is waiting on, when status=blocked
  blockedOn            String?                         @db.Text
  reason               String?                         @db.Text
  // RELATIONAL: document carrying the decisive done/lapsed signal
  resolvedByDocumentId String?                         @db.Uuid
  resolvedByDocument   ProjectDocument?                @relation("ActionItemResolvedBy", fields: [resolvedByDocumentId], references: [id], onDelete: SetNull)
  // verbatim span from the document (evidence)
  textRaw              String                          @db.Text
  // raw model output for this action item; debugging only, not queried
  aiAnalysisOutput     String?                         @db.Text
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@index([projectDocumentId])
  @@index([projectActionItemId])
  @@index([projectId, status])
}

enum ProjectDocumentReferenceResolution {
  notFound
  linked
  contradicted
}

// something a document points to that we try to resolve; resolution is RELATIONAL
model ProjectDocumentReference {
  id                     String                @id @default(uuid()) @db.Uuid
  projectId              String                @db.Uuid
  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromProjectDocumentId  String                @db.Uuid
  fromProjectDocument    ProjectDocument       @relation("ReferenceFromDocument", fields: [fromProjectDocumentId], references: [id], onDelete: Cascade)
  projectDocumentTopicId String?               @db.Uuid
  projectDocumentTopic   ProjectDocumentTopic? @relation(fields: [projectDocumentTopicId], references: [id], onDelete: SetNull)

  // e.g. "Q1 security review", "Phase 2 plan v1"
  referentText          String                             @db.Text
  // what the doc assumes is true about the referent
  expectation           String                             @db.Text
  // notFound (default) = context gap, linked, contradicted
  resolution            ProjectDocumentReferenceResolution @default(notFound)
  resolvedToDocumentId  String?                            @db.Uuid
  resolvedToDocument    ProjectDocument?                   @relation("ReferenceResolvedToDocument", fields: [resolvedToDocumentId], references: [id], onDelete: SetNull)
  resolvedToStatementId String?                            @db.Uuid
  resolvedToStatement   ProjectDocumentStatement?          @relation("ReferenceResolvedToStatement", fields: [resolvedToStatementId], references: [id], onDelete: SetNull)
  // human = a person set the resolution/target (pinned against re-resolution); suppressed hides it
  origin                ProjectDataOrigin                  @default(ai)
  suppressed            Boolean                            @default(false)
  // verbatim span from the document (evidence)
  textRaw               String                             @db.Text
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt

  @@index([fromProjectDocumentId])
  @@index([projectId, resolution])
}

enum ProjectCorrectionEntity {
  statement
  reference
}

enum ProjectCorrectionOperation {
  edit
  invalidate
  add
}

enum ProjectCorrectionStatus {
  active
  orphaned
}

// durable human corrections to per-document entities (statements, references) that have no canonical home; re-applied
// after every extraction by re-binding to the current ai row via a stable anchor, so a correction survives re-extraction
model ProjectDocumentCorrection {
  id                String           @id @default(uuid()) @db.Uuid
  projectId         String           @db.Uuid
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // scope for the anchor; null for a project-wide add
  projectDocumentId String?          @db.Uuid
  projectDocument   ProjectDocument? @relation(fields: [projectDocumentId], references: [id], onDelete: Cascade)

  entity            ProjectCorrectionEntity
  operation         ProjectCorrectionOperation
  // stable identity used to re-bind to the regenerated ai row (statement.textRaw / reference.referentText)
  anchorText        String?                       @db.Text
  anchorEmbedding   Unsupported("halfvec(3072)")?
  // corrected fields (partial), or the full body for an `add`
  patch             Json
  status            ProjectCorrectionStatus       @default(active)
  note              String?                       @db.Text
  correctedByUserId String
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([projectId, entity])
  @@index([projectDocumentId])
}

enum DecisionRecordType {
  architecture
}

enum DecisionRecordStatus {
  proposed
  accepted
  deprecated
  superseded
}

// curated cross-project decision log (operator-promoted, ADR-style); not auto-extracted
model DecisionRecord {
  id                  String               @id @default(uuid()) @db.Uuid
  // null = org-wide architectural decision spanning projects
  projectId           String?              @db.Uuid
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type                DecisionRecordType   @default(architecture)
  title               String
  description         String               @db.Text
  reason              String?              @db.Text
  status              DecisionRecordStatus @default(proposed)
  decidedAt           DateTime?
  // underlying statement ids this record promotes/aggregates (provenance back to documents)
  sourceStatementIds  String[]             @db.Uuid
  supersedesRecordId  String?              @db.Uuid
  supersedesRecord    DecisionRecord?      @relation("DecisionRecordLineage", fields: [supersedesRecordId], references: [id], onDelete: SetNull)
  supersededByRecords DecisionRecord[]     @relation("DecisionRecordLineage")
  // operator who promoted it (curation is a deliberate act)
  createdBy           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([projectId, status])
}
