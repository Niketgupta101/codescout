generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // app uses the pooled connection at runtime - handles short-lived queries efficiently behind PgBouncer
  url       = env("DATABASE_URL")
  // migrations need a direct connection because PgBouncer's transaction-mode pooling breaks long-running DDL
  // for non-Neon setups, leave DIRECT_URL unset and Prisma falls back to DATABASE_URL
  directUrl = env("DIRECT_URL")
}

model User {
  id        String        @id @default(uuid())
  name      String        @default("") // computed
  firstName String        @default("")
  lastName  String        @default("")
  email     String        @unique
  enabled   Boolean
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  deleted   Boolean       @default(false)
  deletedAt DateTime?     @db.Timestamptz(3)
  password  UserPassword?
  sessions  UserSession[]
}

model UserPassword {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique
  passwordHash    String
  attempts        Int      @default(0)
  lastAttemptedAt DateTime @default(now()) @db.Timestamptz(3)
  lastChangedAt   DateTime @default(now()) @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

model UserSession {
  id                    String   @id
  user                  User     @relation(fields: [userId], references: [id])
  userId                String
  refreshTokenHash      String
  refreshTokenExpiresAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
}

model Project {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique
  description   String?
  summary       String?        @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  repositories          Repository[]
  repositoryDirectories RepositoryDirectory[]
  repositoryFiles       RepositoryFile[]
  repositoryFileSymbols RepositoryFileSymbol[]
  projectDocuments      ProjectDocument[]
  conversations         Conversation[]
}

model RepositoryDirectory {
  id              String                @id @default(uuid()) @db.Uuid
  projectId       String                @db.Uuid
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId        String?               @db.Uuid
  parent          RepositoryDirectory?  @relation("RepositoryDirectoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        RepositoryDirectory[] @relation("RepositoryDirectoryHierarchy")

  repositoryFiles RepositoryFile[]

  fullPath        String
  depth           Int
  summary         String?               @db.Text

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([projectId, fullPath])
  @@index([projectId, parentId])
  @@index([projectId, depth])
}

enum RepositoryFileLanguage {
  typescript
  javascript
  csv
  markdown
  pdf
  json
  yaml
  plaintext
  prisma
}

model RepositoryFile {
  id               String                        @id @default(uuid()) @db.Uuid
  projectId        String                        @db.Uuid
  project          Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId     String?                       @db.Uuid
  repository       Repository?                   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  documentId       String?                       @db.Uuid
  document         ProjectDocument?              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  directoryId      String?                       @db.Uuid
  directory        RepositoryDirectory?          @relation(fields: [directoryId], references: [id], onDelete: SetNull)
  fullPath         String
  language         RepositoryFileLanguage
  rawContent       String                        @db.Text
  summary          String?                       @db.Text
  summaryEmbedding Unsupported("halfvec(3072)")?
  metadata         Json?
  checksum         String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  symbols          RepositoryFileSymbol[]

  @@unique([projectId, fullPath])
  @@index([projectId, language])
  @@index([repositoryId])
  @@index([documentId])
  @@index([directoryId])
  @@index([checksum])
}

enum SymbolType {
  heading
  term
  function
  class
  variable
  interface
  type
  enum
  module
}

model RepositoryFileSymbol {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @db.Uuid
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryFileId String         @db.Uuid
  repositoryFile   RepositoryFile @relation(fields: [repositoryFileId], references: [id], onDelete: Cascade)
  name             String
  type             SymbolType
  // 1-indexed inclusive line range of the symbol within the source file
  startLine        Int?
  endLine          Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([projectId, type])
  @@index([projectId, name])
  @@index([name])
  @@index([repositoryFileId])
}

enum RepositoryType {
  backendCodebase
  webCodebase
  appCodebase
  custom
}

enum RepositoryStatus {
  pending
  cloning
  indexing
  completed
  failed
}

model Repository {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @db.Uuid
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  url            String
  branch         String           @default("main")
  lastCommitHash String?
  status         RepositoryStatus @default(pending)
  type           RepositoryType   @default(custom)
  error          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  repositoryFiles RepositoryFile[]
}

enum DocumentFormat {
  csv
  markdown
  pdf
}

enum DocumentType {
  technicalSpecification
  userStories
  meetingNotes
  custom
}

enum DocumentStatus {
  pending
  indexing
  completed
  failed
}

model ProjectDocument {
  id              String           @id @default(uuid()) @db.Uuid
  projectId       String           @db.Uuid
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename        String
  format          DocumentFormat
  status          DocumentStatus   @default(pending)
  documentType    DocumentType     @default(custom)
  metadata        Json?
  error           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  repositoryFiles RepositoryFile[]
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  model     String    @default("gpt-4o-mini")
  provider  String    @default("openai")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([projectId, createdAt])
}

model Message {
  id               String                       @id @default(uuid()) @db.Uuid
  conversationId   String                       @db.Uuid
  conversation     Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assitant         Boolean                      @default(false)
  content          String                       @db.Text
  contentEmbedding Unsupported("halfvec(3072)")?
  toolCalls        Json?
  metadata         Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
}
