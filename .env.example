DATABASE_URL="postgresql://postgres:postgres@localhost:5432/code_rag_dev?schema=public"
OPENAI_API_KEY="your-openai-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# comma-separated list of origins allowed to make credentialed requests
# requests with no Origin header (server-to-server, MCP clients) bypass this check
CORS_ORIGINS_ALLOWED="http://localhost:3000,http://localhost:5173"

# optional, used only by MCP stdio transport as a fallback when no Authorization header is present
MCP_AUTH_TOKEN=""
