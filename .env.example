LOCALE=en
ACCESS_TOKEN_SECRET_BASE64=""
ACCESS_TOKEN_EXPIRES_IN=""
REFRESH_TOKEN_EXPIRES_IN=""
THROTTLE_TTL=""
THROTTLE_LIMIT=""
# Inference (OpenAI or an OpenAI-compatible local server such as Unsloth)
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_DEFAULT_INFERENCE_MODEL=""
# Optional local-inference tuning. Leave unset for the OpenAI production defaults.
OPENAI_INFERENCE_CONCURRENCY=""
OPENAI_INFERENCE_TIMEOUT_MS=""
OPENAI_DOCUMENT_EXTRACTION_CHUNK_TOKENS=""
OPENAI_PIPELINE_MAX_COMPLETION_TOKENS=""

# Embeddings. Leave the base URL empty to use OpenAI's API.
# The embedding key falls back to OPENAI_API_KEY when omitted.
OPENAI_EMBEDDING_BASE_URL=""
OPENAI_EMBEDDING_API_KEY=""
OPENAI_DEFAULT_EMBEDDING_MODEL="text-embedding-3-large"
ANTHROPIC_API_KEY=""
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=""

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/code_rag_dev?schema=public"
# only required when DATABASE_URL points at a connection pooler (e.g. Neon's -pooler endpoint)
# migrations use this direct connection because PgBouncer breaks Prisma's DDL flow
DIRECT_URL=""

# comma-separated list of origins allowed to make credentialed requests
# requests with no Origin header (server-to-server, MCP clients) bypass this check
CORS_ORIGINS_ALLOWED="http://localhost:3000,http://localhost:5173"

STYTCH_PROJECT_ID=""
STYTCH_SECRET=""
STYTCH_PUBLIC_TOKEN=""
STYTCH_DOMAIN="https://your-slug.customers.stytch.com"
APP_PUBLIC_URL="http://localhost:4000"

# poll linked google drive folders hourly and import what changed
PROJECT_FOLDER_SYNC_ENABLED="false"
